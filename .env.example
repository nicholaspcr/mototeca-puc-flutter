DATABASE_URL=postgres://user:password@localhost:5432/mototeca
PORT=8080

# Signs workshop session tokens. REQUIRED — the API refuses to start without
# it, and there is no default: a fallback key would make every deployment
# forgeable. At least 32 characters. Generate one with:
#   openssl rand -base64 48
AUTH_SECRET=

# Object storage for service photos. Leave STORAGE_ENDPOINT empty to run
# without uploads; docker compose sets these for the bundled MinIO.
# STORAGE_ENDPOINT=localhost:9000
# STORAGE_ACCESS_KEY=minioadmin
# STORAGE_SECRET_KEY=minioadmin
# STORAGE_BUCKET=mototeca-photos
# STORAGE_PUBLIC_URL=http://localhost:9000
# STORAGE_USE_SSL=false

# LOG_FORMAT=text          # "text" (default) or "json"
# OTEL_EXPORTER=none       # "none" (default), "stdout", or "otlp"
# OTEL_EXPORTER_OTLP_ENDPOINT=
